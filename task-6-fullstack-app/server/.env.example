# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://saiket:saiket@localhost:5432/orbit
# Used by "npm test" (all its tables are emptied by the tests!)
TEST_DATABASE_URL=postgres://saiket:saiket@localhost:5432/orbit_test
# true for hosted databases that require SSL (Neon, Supabase, external Render URL…)
DATABASE_SSL=false
PORT=3000
# Create the demo accounts on an empty database (password Demo1234). Set to false in real use.
SEED_DEMO=true
