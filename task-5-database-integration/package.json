{
  "name": "saiket-users-api-postgres",
  "version": "1.0.0",
  "description": "Users REST API connected to PostgreSQL with hand-written SQL (SaiKet Systems, Task 5).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/cli.js seed",
    "db:reset": "node --env-file-if-exists=.env src/db/cli.js reset",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:postman": "newman run postman/SaiKet-Users-API.postman_collection.json -e postman/local.postman_environment.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.9"
  }
}
