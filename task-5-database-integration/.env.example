# Copy this file to .env and adjust the values
# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://saiket:saiket@localhost:5432/saiket_users

# Database used by "npm test" (its users table is emptied by the tests!)
TEST_DATABASE_URL=postgres://saiket:saiket@localhost:5432/saiket_users_test

# Set to true for hosted databases that require SSL (Render, Neon, Supabase…)
DATABASE_SSL=false

PORT=3000

# Send the executed SQL in the X-Sql-Queries header (shown by the API explorer). Set to false to hide it.
SHOW_SQL=true
